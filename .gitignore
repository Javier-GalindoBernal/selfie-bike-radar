# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-local/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Flutter build products and local public connection settings
/mobile/.dart_tool/
/mobile/build/
/mobile/.flutter-plugins*
/mobile/android/local.properties
/mobile/ios/Flutter/ephemeral/
/mobile/ios/Flutter/Generated.xcconfig
/mobile/ios/Flutter/flutter_export_environment.sh
/mobile/ios/Runner/GeneratedPluginRegistrant.*
/mobile/ios/Pods/
/mobile/ios/.symlinks/
/mobile/*.iml
/mobile/config.local.json
/deliverables/
